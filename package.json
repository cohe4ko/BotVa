    "@hono/node-server": "^1.19.11",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "cron-parser": "^4.9.0",
    "grammy": "^1.30.0",
    "hono": "^4.12.7",
    "marked": "^17.0.4",
    "node-pty": "^1.1.0",
    "nodemailer": "^8.0.2",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.34.5",
    "ws": "^8.19.0"
