  },
  "homepage": "https://github.com/cohe4ko/BotVa#readme",
  "bugs": {
    "url": "https://github.com/cohe4ko/BotVa/issues"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx scripts/setup.ts",
    "status": "tsx scripts/status.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "admin": "tsx src/admin/server.ts",
    "new-bot": "tsx scripts/new-bot.ts",
    "delete-bot": "tsx scripts/delete-bot.ts"
  },
  "engines": {
    "node": ">=20"
  },
