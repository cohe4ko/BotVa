# ============================================================
# BotVa Bot Configuration
# Copy to bots/<name>/.env and fill in required values
# ============================================================

# === Required ===

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID (send /chatid to your bot to get this)
ALLOWED_CHAT_ID=

# === Google API ===

# Google API key (used for Stagehand browser AI + image generation)
GOOGLE_API_KEY=

# === Voice ===

# Groq API key for speech-to-text (free: https://console.groq.com)
GROQ_API_KEY=

# STT model (default: whisper-large-v3)
# GROQ_STT_MODEL=whisper-large-v3

# STT language hint (auto-detect if not set). Values: uk, ru, en, etc.
# GROQ_STT_LANGUAGE=

# STT prompt hint (helps with domain-specific terms)
# GROQ_STT_PROMPT=

# TTS speech rate (default: +30%)
# TTS_RATE=+30%

# TTS voice overrides per language
# TTS_VOICE_UK=uk-UA-OstapNeural
# TTS_VOICE_RU=ru-RU-DmitryNeural
# TTS_VOICE_EN=en-US-AndrewNeural

# === Models ===

# Stagehand browser AI model (default: google/gemini-2.5-flash)
# STAGEHAND_MODEL=google/gemini-2.5-flash

# Image generation model (default: gemini-3.1-flash-image-preview)
# IMAGEN_MODEL=gemini-3.1-flash-image-preview

# === Admin Panel ===

# Token for standalone admin panel (required if running admin without Telegram)
# ADMIN_TOKEN=

# Admin panel port (default: 3000)
# ADMIN_PORT=3000

# Public admin URL (for Telegram buttons, e.g. https://admin.example.com)
# If not set, uses local IP + port
# ADMIN_HOST=

# === Telegraph ===

# Enable/disable Telegraph for long messages (default: true)
# TELEGRAPH_ENABLED=true

# === Agent Watchdog ===

# Warn after N seconds of agent inactivity (default: 60)
# AGENT_WATCHDOG_WARN_SECONDS=60

# Kill agent after N ms of inactivity (default: 600000 = 10 min)
# AGENT_WATCHDOG_TIMEOUT_MS=600000

# === Memory System ===

# Enable semantic search with embeddings (default: false)
# EMBEDDINGS_ENABLED=false

# Embedding model (default: nomic-embed-text-v1.5.f16.gguf)
# EMBEDDING_MODEL=nomic-embed-text-v1.5.f16.gguf

# Hour boundary for "night owl" date rollover (default: 4 = 04:00)
# NIGHT_OWL_HOUR=4

# Preview lengths in daily log (chars)
# USER_PREVIEW_LEN=200
# ASSISTANT_PREVIEW_LEN=300

# Min message length to save to memory (default: 20)
# MIN_MSG_LEN_TO_SAVE=20

# Min assistant reply length to save (default: 50)
# MIN_ASSISTANT_LEN_TO_SAVE=50

# Max assistant memory entry length (default: 500)
# MAX_ASSISTANT_MEMORY_LEN=500

# === Integrations (optional) ===

# Bitrix24 CRM
# BITRIX24_WEBHOOK_URL=

# Google Workspace (OAuth)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# USER_GOOGLE_EMAIL=

# Home Assistant
# HA_URL=
# HA_TOKEN=

# Meta Ads (Facebook/Instagram)
# META_ACCESS_TOKEN=
# META_APP_SECRET=

# Email (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SIGNATURE=**Name**\nTitle, Company

# === Website (webmaster role) ===

# Local site directory (e.g. ~/Sites/mysite)
# SITE_DIR=

# Site URL for health checks
# SITE_URL=

# SSH host for deploy (e.g. user@server.com)
# SITE_SSH_HOST=

# Remote directory on server (e.g. /var/www/mysite)
# SITE_REMOTE_DIR=

# SSH port (default: 22)
# SITE_SSH_PORT=22

# Database credentials (optional, read-only by default)
# SITE_DB_NAME=
# SITE_DB_USER=
# SITE_DB_PASS=

# === Publishing ===

# File publishing (ShareFile tool)
# If PUBLISH_SSH_HOST is set — uploads via SSH (scp)
# If not set — copies locally (for servers with direct web access)
# PUBLISH_SSH_HOST=
# PUBLISH_REMOTE_DIR=/var/www/files
# PUBLISH_BASE_URL=https://files.example.com

# === Crash Watchdog Notifications ===
# (set in ROOT .env, not per-bot)

# Bot token for sending crash/deploy notifications
# NOTIFY_BOT_TOKEN=

# Chat ID for crash/deploy notifications (admin)
# NOTIFY_CHAT_ID=

# === Logging ===

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# === Workspace-files feature flags ===
# Control which conditional sections (<!-- IF FEATURE -->...<!-- END -->) of
# roles/_soul.md and other shards are included in this bot's CLAUDE.md.
# Default: all 0 (lean assistant). Enable selectively per bot capabilities.

# Enable group chat protocol (multi-bot dialogue, role detection, /stop)
GROUP_CHAT_ENABLED=0

# Enable dev planning procedure (AskUser before code changes, two modes)
DEV_MODE_ENABLED=0

# Enable git workflow guidance (commit conventions, ask before push)
GIT_ACCESS_ENABLED=0
