{
  "playwright-remote": {
    "command": "npx",
    "args": [
      "@playwright/mcp"
    ],
    "enabled": true,
    "persistent": true
  },
  "stagehand": {
    "command": "/bin/sh",
    "args": [
      "-c",
      "STAGEHAND_ENV=LOCAL npx stagehand-mcp-local --modelName google/gemini-2.5-flash"
    ],
    "envVars": [
      "GOOGLE_API_KEY"
    ],
    "envPassthrough": [
      "GOOGLE_API_KEY"
    ],
    "enabled": true,
    "persistent": true
  },
  "google-workspace": {
    "command": "uvx",
    "args": [
      "workspace-mcp",
      "--single-user",
      "--tool-tier",
      "core"
    ],
    "envVars": [
      "GOOGLE_OAUTH_CLIENT_ID",
      "GOOGLE_OAUTH_CLIENT_SECRET"
    ],
    "envPassthrough": [
      "GOOGLE_OAUTH_CLIENT_ID",
      "GOOGLE_OAUTH_CLIENT_SECRET",
      "USER_GOOGLE_EMAIL",
      "OAUTHLIB_INSECURE_TRANSPORT"
    ],
    "enabled": true
  },
  "home-assistant": {
    "command": "uvx",
    "args": [
      "hass-mcp"
    ],
    "envVars": [
      "HA_URL",
      "HA_TOKEN"
    ],
    "envPassthrough": [
      "HA_URL",
      "HA_TOKEN"
    ],
    "enabled": true
  }
}
