# Orange Pi Listener Configuration
# Copy to config.env and fill in values

# === WiFi ===
WIFI_SSID="your_wifi_name"
WIFI_PASSWORD="your_wifi_password"

# === Device ===
# Unique ID for this device (useful if you have multiple Orange Pis)
DEVICE_ID="opi-1"

# === Recording ===
# Chunk duration in seconds (300 = 5 min)
CHUNK_DURATION=300
# Overlap in seconds added to each chunk (captures speech split across boundaries)
CHUNK_OVERLAP=10
# Silence threshold (0-100, higher = more sensitive)
SILENCE_THRESHOLD=3
# Min speech percentage to keep chunk (0-100)
MIN_SPEECH_PCT=15
# Audio format
SAMPLE_RATE=16000
CHANNELS=1

# === Upload ===
# Server URL to POST audio files (BotVa receiver endpoint)
UPLOAD_URL="http://your-server:3847/audio"
# Auth token for upload endpoint
UPLOAD_TOKEN=""
# Retry interval in seconds when upload fails
RETRY_INTERVAL=60
# Max retries before giving up on a chunk
MAX_RETRIES=50

# === Storage ===
# Local directory for audio chunks (deleted after successful upload)
AUDIO_DIR="/data/audio"
# Local directory for failed uploads (retry queue)
QUEUE_DIR="/data/queue"
# Max local storage in MB (oldest files deleted when exceeded)
MAX_STORAGE_MB=4000
