# Orange Pi Listener Configuration
# Copy to config.env and fill in values

# === WiFi ===
WIFI_SSID="your_wifi_name"
WIFI_PASSWORD="your_wifi_password"

# === Transcription API ===
# Provider: "groq" (Whisper, $0.11/hr) or "xai" (when available)
STT_PROVIDER="groq"

# Groq API (https://console.groq.com)
GROQ_API_KEY="gsk_..."

# xAI API (https://console.x.ai) — for future use
XAI_API_KEY=""

# === Recording ===
# Chunk duration in seconds (300 = 5 min)
CHUNK_DURATION=300
# Silence threshold (0-100, higher = more sensitive)
SILENCE_THRESHOLD=3
# Min speech percentage to keep chunk (0-100)
MIN_SPEECH_PCT=15
# Audio format
SAMPLE_RATE=16000
CHANNELS=1

# === Upload ===
# Remote server URL to POST transcripts
UPLOAD_URL=""
# Auth token for upload endpoint
UPLOAD_TOKEN=""
# Retry interval in seconds when upload fails
RETRY_INTERVAL=60
# Max retries before giving up on a chunk
MAX_RETRIES=50

# === Storage ===
# Local directory for audio chunks (auto-cleaned after upload)
AUDIO_DIR="/data/audio"
# Local directory for transcripts
TRANSCRIPT_DIR="/data/transcripts"
# Local directory for failed uploads (retry queue)
QUEUE_DIR="/data/queue"
# Keep audio files after successful transcription? (true/false)
KEEP_AUDIO=false
# Max local storage in MB (oldest files deleted when exceeded)
MAX_STORAGE_MB=2000
